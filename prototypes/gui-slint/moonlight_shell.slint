import { Button, HorizontalBox, ListView, VerticalBox } from "std-widgets.slint";

export struct HostEntry {
    name: string,
    status: string,
    paired: bool,
    busy: bool,
}

export component MoonlightShell inherits Window {
    in property <[HostEntry]> hosts;

    callback host_accepted(int);
    callback settings_requested();

    title: "Moonlight";
    width: 960px;
    height: 540px;

    VerticalBox {
        padding: 24px;
        spacing: 16px;

        HorizontalBox {
            Text {
                text: "Moonlight";
                font-size: 32px;
                horizontal-stretch: 1;
            }

            Button {
                text: "Settings";
                clicked => {
                    root.settings_requested();
                }
            }
        }

        Text {
            text: "Prototype shell: mouse, touch, keyboard focus, and controller-style accept/back navigation must all remain first-class inputs.";
            wrap: word-wrap;
        }

        ListView {
            for host[index] in root.hosts : Rectangle {
                height: 72px;
                border-radius: 8px;
                border-width: 1px;
                border-color: #606060;
                background: touch.pressed ? #365c85 : touch.has-hover ? #2c3f54 : #20242b;

                touch := TouchArea {
                    clicked => {
                        root.host_accepted(index);
                    }
                }

                HorizontalBox {
                    padding: 16px;
                    spacing: 16px;

                    VerticalBox {
                        horizontal-stretch: 1;

                        Text {
                            text: host.name;
                            font-size: 20px;
                            color: white;
                        }

                        Text {
                            text: host.status;
                            color: host.paired ? #b8f5c3 : #ffd27a;
                        }
                    }

                    Text {
                        text: host.busy ? "In Game" : "";
                        color: #9bd2ff;
                    }
                }
            }
        }
    }
}
